# Copy to .env (never commit .env). All values are optional for local development.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
COURTVISION_ENV=development        # set to "production" to require SECRET_KEY
COURTVISION_DEBUG=false
COURTVISION_HOST=127.0.0.1
COURTVISION_PORT=5000
# Comma-separated origins allowed to open the Socket.IO connection (empty = same-origin only)
CORS_ORIGINS=
# Optional AI Analyst. Get a free Gemini key at https://aistudio.google.com/apikey - without a key a rule-based summary is shown, clearly labelled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# (alternative provider; Gemini is used first when both are set)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: outbound proxy for NBA data if your network blocks stats.nba.com / cdn.nba.com
NBA_PROXY=
COURTVISION_HTTP_TIMEOUT=30
COURTVISION_LIVE_POLL_SECONDS=6
